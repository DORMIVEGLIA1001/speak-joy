PORT=8000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/speakjoy
PGCLIENTENCODING=UTF8
CORS_ORIGINS=http://localhost:3005,http://127.0.0.1:3005,http://localhost:3000,http://127.0.0.1:3000

AI_PROVIDER=gemini
AI_BASE_URL=https://generativelanguage.googleapis.com
AI_MODEL=gemini-2.5-flash
AI_API_KEY=your_api_key
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=
AI_FALLBACK2_PROVIDER=
AI_FALLBACK2_MODEL=
AI_FALLBACK2_API_KEY=
AI_FALLBACK2_BASE_URL=

# TTS provider
# Supported values in be/ai_service/app.py: comfyui, dashscope, vieneu_remote
TTS_PROVIDER=comfyui
TTS_SAMPLE_RATE=24000

# VieNeu-TTS remote service
# Run VieNeu-TTS/apps/web_stream.py separately, then point this URL at that service.
# Examples:
# VIENEU_TTS_BASE_URL=http://127.0.0.1:8001
# VIENEU_TTS_BASE_URL=http://127.0.0.1:8001/stream
# If you accidentally keep /v1, the backend will also try stripping it.
VIENEU_TTS_BASE_URL=
VIENEU_TTS_TIMEOUT_SECONDS=60
# Optional fixed voice id from the VieNeu service. If empty, backend falls back
# to the requested speaker name and finally the service default voice.
VIENEU_TTS_VOICE_ID=
VIENEU_TTS_API_KEY=
VIENEU_TTS_FORMAT=wav
VIENEU_TTS_STYLE=tu_nhien

JWT_SECRET=
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false

# Master secret used to derive a unique Fernet key per row with scrypt + random salt.
# Generate a strong random value and store it in your secret manager.
MASTER_SECRET=

# Legacy Fernet key used only to read rows written before MASTER_SECRET was introduced.
# Optional during migration.
ENCRYPTION_KEY=

# Frontend base URL used for OAuth callback redirects and default WebAuthn origin/rp fallback.
# In local, keep this exactly equal to the URL you open in the browser.
# Example:
# - If you open http://localhost:3005, keep localhost
# - If you open http://127.0.0.1:3005, change this to 127.0.0.1
FRONTEND_BASE_URL=http://localhost:3005
AUTH_SUCCESS_REDIRECT_PATH=/
AUTH_ERROR_REDIRECT_PATH=/

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3005/api/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3005/api/auth/facebook/callback

# SMTP used for one-time password reset links. In development, an unset SMTP
# prints the reset URL to the backend console; production requires SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Port 587 normally uses SMTP_USE_TLS=true. Port 465 normally uses
# SMTP_USE_TLS=false and SMTP_USE_SSL=true.

SPEAKJOY_STREAMING_ASR_PROVIDER=qwen3_rolling
