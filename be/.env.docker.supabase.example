PORT=8000
NODE_ENV=production

# Production origins. Replace with your real frontend domain only.
CORS_ORIGINS=https://speak-joy.chainz.tech

DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true
JWT_SECRET=change-me-to-a-long-random-secret

AUTH_COOKIE_DOMAIN=speak-joy.chainz.tech
AUTH_COOKIE_SECURE=true

AI_PROVIDER=gemini
AI_BASE_URL=https://generativelanguage.googleapis.com
AI_MODEL=gemini-2.5-flash
AI_API_KEY=

ASR_PROVIDER=comfyui
ASR_API_KEY=
ASR_API_MODEL=qwen3-asr-flash
ASR_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
COMFYUI_URL=
COMFYUI_AUTH_USER=
COMFYUI_AUTH_PASSWORD=
COMFYUI_ASR_WORKFLOW=./be/ai_service/workflows/qwen3_asr_comfyui_api.json
COMFYUI_ASR_TIMEOUT_SECONDS=120
COMFYUI_ASR_POLL_INTERVAL_SECONDS=0.5

TTS_PROVIDER=comfyui
COMFYUI_TTS_WORKFLOW=./be/ai_service/workflows/qwen3_tts_comfyui_api.json
COMFYUI_TTS_TIMEOUT_SECONDS=180
COMFYUI_TTS_SPEAKER=Ryan
COMFYUI_TTS_MODEL_CHOICE=0.6B
COMFYUI_TTS_DEVICE=cuda
COMFYUI_TTS_PRECISION=bf16
COMFYUI_TTS_LANGUAGE=English

SCORE_MODE=llm

HTTPX_TRUST_ENV=false
VALIDATION_TIMEOUT_SECONDS=30
KIDBOT_MAX_TOPICS_PER_SESSION=3
KIDBOT_MAX_WORDS_PER_TOPIC=15
KIDBOT_SESSION_TTL_SECONDS=21600

# OAuth + WebAuthn must use the exact public frontend domain
FRONTEND_BASE_URL=https://speak-joy.chainz.tech
AUTH_SUCCESS_REDIRECT_PATH=/topics
AUTH_ERROR_REDIRECT_PATH=/login

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api-speak-joy.chainz.tech/api/auth/google/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://api-speak-joy.chainz.tech/api/auth/facebook/callback

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
